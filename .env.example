# Zona horaria para interpretar fechas y horas
TZ=Europe/Madrid

# --- Notion ---
# Crea una integración en https://www.notion.so/profile/integrations,
# copia el token y comparte tu base de datos de tareas con ella.
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxx
# El ID de la base de datos está en su URL: notion.so/<ID>?v=...
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Nombres de las columnas. Si los dejas vacíos se detectan solos
# (la primera columna de tipo fecha y la primera de tipo estado/checkbox).
NOTION_DATE_PROPERTY=
NOTION_STATUS_PROPERTY=
# Valores de estado que cuentan como "terminada" (separados por comas)
NOTION_DONE_VALUES=Hecho,Completado,Terminado,Listo,Done,Completed

# --- Recordatorios ---
# Hora del resumen diario de tareas (HH:MM). Vacío para desactivarlo.
DAILY_SUMMARY_TIME=08:00
# Aviso X minutos antes de las tareas que tienen hora en Notion. 0 para desactivarlo.
TASK_REMINDER_MINUTES=15

# --- WhatsApp ---
# Vacío: hablas con el bot desde tu chat "Tú" (mensajes a ti mismo).
# Con un número: el bot va vinculado a OTRO número y te escribe a este
# (así los recordatorios suenan como notificación normal).
OWNER_NUMBER=
# Prefijo que se añade a números sin código de país
DEFAULT_COUNTRY_CODE=34
# Para vincular con código en vez de QR (tu número con prefijo, solo dígitos)
PAIRING_NUMBER=
# Si el bot estuvo apagado, no envía mensajes programados con más de X horas de retraso
MAX_LATE_HOURS=6
